{
  "mode": "lora",
  "epochs": 1,
  "global_batch_size": 64,
  "micro_batch": 4,
  "max_micro_tokens": 16384,
  "max_len": 16384,
  "learning_rate": 5e-05,
  "head_learning_rate": 0.0002,
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_targets": "all-linear",
  "slots": 1,
  "replay_fraction": 0.0,
  "replay_kl_weight": 0.0,
  "decision_ordinal_weight": 0.0,
  "decision_brier_weight": 0.0,
  "quality_matched_only": false,
  "selection_metric": "joint",
  "include_initial_selection": true,
  "retention_tagged_only": false,
  "max_decision_regression": 0.03,
  "max_grounding_regression": 0.05,
  "batch_decisions": true,
  "eval_every": 500,
  "eval_limit": 512,
  "video_cache_dir": ".cache/multimodal-video",
  "seed": 105,
  "projector_learning_rate": 2e-05,
  "warmup_ratio": 0.05,
  "min_lr_ratio": 0.1,
  "length_bucketing": true
}
